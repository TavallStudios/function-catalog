#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
origin=''
repository=''
expected_head=''
profile=''
evidence_handle=''

usage() {
    printf '%s\n' 'Usage: scripts/ci/run --origin <github-bot|chatgpt|codex|manual|scheduler> --repository TavallStudios/function-catalog --expected-head <sha> --profile <build|integration|all> --evidence-handle <tavall-storage://...>' >&2
}

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --origin) origin="${2:-}"; shift 2 ;;
        --repository) repository="${2:-}"; shift 2 ;;
        --expected-head) expected_head="${2:-}"; shift 2 ;;
        --profile) profile="${2:-}"; shift 2 ;;
        --evidence-handle) evidence_handle="${2:-}"; shift 2 ;;
        *) usage; exit 64 ;;
    esac
done

case "${origin}" in
    github-bot|chatgpt|codex|manual|scheduler) ;;
    *) printf '%s\n' 'unsupported Tavall CI origin' >&2; exit 64 ;;
esac
[[ "${repository}" == 'TavallStudios/function-catalog' ]] || { printf '%s\n' 'repository must be TavallStudios/function-catalog' >&2; exit 64; }
[[ "${expected_head}" =~ ^[a-f0-9]{40}$ ]] || { printf '%s\n' 'expected head must be an exact lowercase SHA-1' >&2; exit 64; }
case "${profile}" in
    build|integration|all) ;;
    *) printf '%s\n' 'profile must be build, integration, or all' >&2; exit 64 ;;
esac
[[ "${evidence_handle}" =~ ^tavall-storage://[a-z0-9][a-z0-9-]{1,62}/jobs/[0-9a-f-]{36}$ ]] \
    || { printf '%s\n' 'evidence handle must identify a DEV STORAGE job location' >&2; exit 64; }

cd "${repository_root}"
actual_head="$(git rev-parse HEAD)"
[[ "${actual_head}" == "${expected_head}" ]] || {
    printf 'expected head mismatch: expected=%s actual=%s\n' "${expected_head}" "${actual_head}" >&2
    exit 65
}
branch="$(git branch --show-current)"
[[ -n "${branch}" ]] || { printf '%s\n' 'Tavall CI requires a named branch' >&2; exit 65; }

run_build() {
    ./gradlew --no-daemon --max-workers=1 clean check publishToMavenLocal stageRuntime
}

run_integration() {
    ./gradlew --no-daemon --max-workers=1 :mcp-server:integrationTest
}

case "${profile}" in
    build)
        run_build
        ;;
    integration)
        run_integration
        ;;
    all)
        run_build
        run_integration
        if [[ "${origin}" == 'manual' ]]; then
            [[ "${branch}" == working/* ]] || {
                printf '%s\n' 'manual snapshot publication is restricted to working/* branches' >&2
                exit 66
            }
            # shellcheck source=../lib/resolve-github-packages.sh
            source "${repository_root}/scripts/lib/resolve-github-packages.sh"
            tavall_resolve_github_packages
            ./gradlew --no-daemon --max-workers=1 publish
            unset GITHUB_TOKEN
            printf 'Published Function Catalog working-branch SNAPSHOT from %s@%s\n' "${branch}" "${actual_head}"
        fi
        ;;
esac

printf 'Function Catalog CI profile %s passed. evidenceHandle=%s\n' "${profile}" "${evidence_handle}"
