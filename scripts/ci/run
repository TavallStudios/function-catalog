#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
origin=''
repository=''
expected_head=''
profile='build'
evidence_handle=''

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --origin) origin="${2:-}"; shift 2 ;;
        --repository) repository="${2:-}"; shift 2 ;;
        --expected-head) expected_head="${2:-}"; shift 2 ;;
        --profile) profile="${2:-}"; shift 2 ;;
        --evidence-handle) evidence_handle="${2:-}"; shift 2 ;;
        *) printf 'Unknown CI argument: %s\n' "$1" >&2; exit 64 ;;
    esac
done

case "${origin}" in github-bot|chatgpt|codex|manual|scheduler) ;; *) printf '%s\n' 'Invalid CI origin' >&2; exit 64 ;; esac
[[ "${repository}" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || { printf '%s\n' 'Invalid repository identity' >&2; exit 64; }
[[ "${expected_head}" =~ ^([a-f0-9]{40}|[a-f0-9]{64})$ ]] || { printf '%s\n' 'Invalid expected HEAD' >&2; exit 64; }
case "${profile}" in build|integration|all) ;; *) printf '%s\n' 'Invalid CI profile' >&2; exit 64 ;; esac
[[ "${evidence_handle}" == tavall-storage://* ]] || { printf '%s\n' 'Invalid Tavall evidence handle' >&2; exit 64; }

cd "${repository_root}"
actual_head="$(git rev-parse HEAD)"
[[ "${actual_head}" == "${expected_head}" ]] || {
    printf 'Expected HEAD %s but workspace is %s\n' "${expected_head}" "${actual_head}" >&2
    exit 65
}

export TAVALL_CI_ORIGIN="${origin}"
export TAVALL_CI_EXPECTED_HEAD="${expected_head}"
export TAVALL_CI_CHECK_CONTEXT="tavall-ci/${origin}/${profile}"
export TAVALL_CI_EVIDENCE_HANDLE="${evidence_handle}"

bash scripts/ci/verify "${profile}"
