#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
version="${1:-}"

if [[ ! "${version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    printf '%s\n' 'Usage: bash scripts/release/publish <semver>' >&2
    exit 64
fi

if [[ -z "${GITHUB_TOKEN:-}" ]]; then
    if command -v gh >/dev/null 2>&1; then
        GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"
        export GITHUB_TOKEN
    fi
fi
if [[ -z "${GITHUB_TOKEN:-}" ]]; then
    printf '%s\n' 'Publishing requires GITHUB_TOKEN or an authenticated gh session.' >&2
    exit 1
fi
export GITHUB_ACTOR="${GITHUB_ACTOR:-$(gh api user --jq .login 2>/dev/null || printf tavall-local)}"

cd "${repository_root}"
bash scripts/ci/verify
./gradlew --no-daemon --max-workers=1 -PtavallVersion="${version}" publish
